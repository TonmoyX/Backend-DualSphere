# ── Server ──
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# COOKIE_DOMAIN=.dualsphere.app     # prod: share cookies across api./www./admin.
TRUST_PROXY=0                       # set to 1 behind Cloudflare / a load balancer

# ── PostgreSQL ──
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dualsphere

# ── Redis (optional; enables distributed rate limiting) ──
# REDIS_URL=redis://localhost:6379

# ── Secrets: generate with `npm run keys` (each 32 bytes hex) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
IDENTITY_ENC_KEY=
IDENTITY_HMAC_KEY=
AUDIT_HMAC_KEY=
MFA_ENC_KEY=
IP_HASH_SALT=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ── Cloudflare R2 (images + videos). Leave empty to store uploads on local disk. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dualsphere-media
R2_PUBLIC_URL=                      # e.g. https://media.dualsphere.app or https://pub-xxxx.r2.dev

# ── WebRTC calls (optional TURN relay; STUN works out of the box) ──
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ── SMTP (optional; emails print to the console when unset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DualSphere <no-reply@dualsphere.app>

# ── Seed admin ──
SEED_ADMIN_EMAIL=admin@dualsphere.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!2026

# true = browsers upload straight to R2 (requires a CORS rule on the bucket). false = upload via the API, which stores in R2.
R2_DIRECT_UPLOAD=false

# Demo moderator account (seed)
SEED_MODERATOR_EMAIL=mod@dualsphere.local
SEED_MODERATOR_USERNAME=moderator
SEED_MODERATOR_PASSWORD=change-me

# ── Money (DualSphere Next · Phase 2) — everything is charged in US dollars (amounts in cents) ──
DEFAULT_CURRENCY=USD
PLATFORM_FEE_BPS=1000                 # 10% platform fee on tips, memberships and paid posts
PAYOUT_HOLD_DAYS=7                    # refund window before earnings can be withdrawn
PAYOUT_MIN_MINOR=1000                 # $10 minimum payout
PAYOUT_ADMIN_THRESHOLD_MINOR=50000    # payouts above $500 need an admin
# FINANCE_ENC_KEY=                    # 64 hex chars; encrypts payout details + KYC numbers (derived from IDENTITY_ENC_KEY if unset)
PAYMENTS_TEST_MODE=false              # local fake checkout for development; ignored in production

# Stripe (https://dashboard.stripe.com/apikeys). Test keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
# Webhook: Dashboard → Developers → Webhooks → endpoint  https://<api-host>/api/v1/payments/webhooks/stripe
# events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired
# Locally: `stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe` prints the whsec_ secret.
STRIPE_WEBHOOK_SECRET=

# SSLCommerz (sandbox: https://developer.sslcommerz.com/registration/). IPN URL is set automatically per payment:
#   https://<api-host>/api/v1/payments/webhooks/sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ── Ads + AI (Phase 3) ──
ADS_MIN_DAILY_BUDGET_MINOR=500        # $5
ANTHROPIC_API_KEY=                    # optional: AI Ad Studio uses templates without it
# AI_MODEL_COPY=claude-opus-5-5
AI_JOBS_PER_DAY=10
AI_MAX_VIDEO_SEC=90
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
WORKER_IN_PROCESS=false               # true = run the background worker inside the API (dev); production: `npm run worker`
