{
  "name": "dualsphere-api",
  "version": "1.0.0",
  "private": true,
  "description": "DualSphere API \u2014 Express + PostgreSQL + JWT + Cloudflare R2 + Socket.io",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "tsx --env-file=.env src/db/create.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "keys": "node -e \"const c=require('crypto');for(const k of ['JWT_ACCESS_SECRET','JWT_REFRESH_SECRET','IDENTITY_ENC_KEY','IDENTITY_HMAC_KEY','AUDIT_HMAC_KEY','MFA_ENC_KEY','IP_HASH_SALT'])console.log(k+'='+c.randomBytes(32).toString('hex'))\"",
    "worker": "node --env-file=.env dist/worker.js",
    "worker:dev": "tsx watch --env-file=.env src/worker.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "sanitize-html": "^2.18.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
